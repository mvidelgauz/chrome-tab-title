{
  "manifest_version": 3,
  "name": "Chrome Tab Title",
  "version": "0.3.0",
  "description": "Assign persistent custom titles to browser tabs by exact URL, wildcard URL pattern, or site.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Chrome Tab Title",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{21666d6e-3c6c-45a3-ac6d-8c0f92206bfe}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
